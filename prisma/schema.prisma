generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastDailyBonusAt DateTime?

  accounts      Account[]
  sessions      Session[]
  creditsLedger CreditsLedger[]
  events        Event[]
  projects      QAProject[]
  reports       QAReport[]
  jiraConfigs   JiraConfig[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditsLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  ref       String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
  @@index([userId, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metaJson  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model StripeEvent {
  id        String   @id
  type      String
  livemode  Boolean
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model QAProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  productType String   @default("other")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports QAReport[]
  sources QAProjectSource[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model QAProjectSource {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  sourceType String   @default("other")
  body       String
  tags       String[] @default([])
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project QAProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isEnabled])
  @@index([projectId, updatedAt])
  @@index([sourceType])
}

model JiraConfig {
  id                  String   @id @default(cuid())
  userId              String
  siteUrl             String
  projectKey          String
  defaultIssueType    String   @default("Task")
  defaultBugIssueType String   @default("Bug")
  fieldMapping        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([projectKey])
  @@index([createdAt])
}

model QAReport {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  type           String
  title          String?
  markdown       String?
  structuredData Json?
  sourceInput    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project QAProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([type, createdAt])
}
