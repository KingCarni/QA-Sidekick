generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastDailyBonusAt DateTime?

  accounts      Account[]
  sessions      Session[]
  creditsLedger CreditsLedger[]
  events        Event[]
  projects      QAProject[]
  reports       QAReport[]
  bugCollectionItems BugCollectionItem[]
  jiraConfigs   JiraConfig[]
  testRailConfigs TestRailConfig[]
  testRailCaseSyncMaps TestRailCaseSyncMap[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CreditsLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int
  reason    String
  ref       String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ref])
  @@index([userId, createdAt])
}

model Event {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  metaJson  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model StripeEvent {
  id        String   @id
  type      String
  livemode  Boolean
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

model QAProject {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  productType String   @default("other")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports QAReport[]
  sources QAProjectSource[]
  rules   QAProjectRule[]
  bugCollectionItems BugCollectionItem[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model QAProjectSource {
  id         String   @id @default(cuid())
  projectId  String
  title      String
  sourceType String   @default("other")
  body       String
  tags       String[] @default([])
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project QAProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isEnabled])
  @@index([projectId, updatedAt])
  @@index([sourceType])
}

model QAProjectRule {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  category    String   @default("coverage")
  severity    String   @default("medium")
  appliesTo   String[] @default(["all"])
  body        String
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project QAProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, isEnabled])
  @@index([projectId, updatedAt])
  @@index([category])
  @@index([severity])
}

model BugCollectionItem {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  title          String
  status         String   @default("new")
  severity       String?
  priority       String?
  summary        String?
  environment    String?
  steps          String[] @default([])
  expectedResult String?
  actualResult   String?
  impact         String?
  missingInfo    String[] @default([])
  followUps      String[] @default([])
  qaNotes        String[] @default([])
  sourceInput    String?
  markdown       String?
  structuredData Json?
  jiraIssueKey   String?
  jiraIssueUrl   String?
  tags           String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project QAProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([severity])
  @@index([priority])
}

model JiraConfig {
  id                  String   @id @default(cuid())
  userId              String
  siteUrl             String
  jiraEmail           String?
  encryptedApiToken   String?
  projectKey          String
  defaultIssueType    String   @default("Task")
  defaultBugIssueType String   @default("Bug")
  fieldMapping        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([projectKey])
  @@index([createdAt])
}

model QAReport {
  id             String   @id @default(cuid())
  userId         String
  projectId      String?
  type           String
  title          String?
  markdown       String?
  structuredData Json?
  sourceInput    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project QAProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  testRailSyncMaps TestRailCaseSyncMap[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([type, createdAt])
}

model TestRailConfig {
  id               String   @id @default(cuid())
  userId           String
  baseUrl          String
  username         String
  encryptedApiKey  String
  projectId        Int
  suiteId          Int?
  defaultSectionId Int
  milestoneId      Int?
  runId            Int?
  fieldMapping     Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([projectId])
  @@index([createdAt])
}

model TestRailCaseSyncMap {
  id             String    @id @default(cuid())
  userId         String
  reportId       String?
  testCaseIndex  Int?
  title          String
  testRailCaseId Int?
  projectId      Int
  suiteId        Int?
  sectionId      Int
  contentHash    String
  syncStatus     String    @default("synced")
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  report QAReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@unique([userId, contentHash])
  @@unique([userId, testRailCaseId])
  @@index([userId, updatedAt])
  @@index([reportId])
  @@index([syncStatus])
}
