# QAtalyst local environment example
# Copy this to .env.local and fill in real local/test values.
# Never commit .env or .env.local.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# OpenAI
OPENAI_API_KEY="sk-proj_replace-me"

# Stripe test mode
STRIPE_SECRET_KEY="sk_test_replace-me"
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
STRIPE_EXPECT_LIVEMODE="false"

# Optional
ADMIN_EMAIL="you@example.com"
